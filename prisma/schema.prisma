generator client {
  provider = "prisma-client-js"
}

// Local development default (SQLite). For Neon/Supabase PostgreSQL, change provider to "postgresql"
// or copy prisma/schema.postgres.prisma -> prisma/schema.prisma
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. User (Single admin user created by seed; no public sign-up)
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Admin")
  role         String   @default("SUPERADMIN")
  createdAt    DateTime @default(now())
}

// 2. Profile (Single row: id = "main")
// One canonical column per datum: bilingual text uses `_uz` / `_en`, links are plain columns.
model Profile {
  id              String   @id @default("main")
  name            String
  heroLine1_uz    String   @default("MIRHAMID")
  heroLine1_en    String   @default("MIRHAMID")
  heroLine2_uz    String   @default("ERJIGITOV *26")
  heroLine2_en    String   @default("ERJIGITOV *26")
  availability_uz String   @default("Loyihalarga ochiq*")
  availability_en String   @default("Open to work*")
  rolePill_uz     String   @default("AI • KIBERXAVFSIZLIK • DEVOPS")
  rolePill_en     String   @default("AI • CYBERSECURITY • DEVOPS")
  headline_uz     String
  headline_en     String
  bio_uz          String
  bio_en          String
  about_uz        String   @default("")
  about_en        String   @default("")
  specialties_uz  String   @default("[]") // JSON 4-item array
  specialties_en  String   @default("[]") // JSON 4-item array
  avatarConfig    String   @default("{}") // JSON config
  avatarUrl       String   @default("/avatar.svg")
  cvUrl_uz        String   @default("/cv-uz.pdf")
  cvUrl_en        String   @default("/cv-en.pdf")
  email           String
  phone           String   @default("")
  location        String
  githubUrl       String   @default("")
  linkedinUrl     String   @default("")
  telegramUrl     String   @default("")
  pgpKey          String   @default("")
  uptimeStatus    String   @default("99.98% • Zero-Trust Verified")
  updatedAt       DateTime @updatedAt
}

// 3. Project (Many-to-many with Skill)
model Project {
  id             String   @id @default(cuid())
  slug           String   @unique
  title_uz       String
  title_en       String
  summary_uz     String
  summary_en     String
  description_uz String   // Markdown
  description_en String   // Markdown
  coverImage     String   @default("")
  gallery        String   @default("[]") // JSON array of image URLs
  category       String   // "AI" | "CYBERSECURITY" | "DEVOPS"
  liveUrl        String   @default("")
  repoUrl        String   @default("")
  featured       Boolean  @default(true)
  order          Int      @default(0)
  published      Boolean  @default(true)
  skills         Skill[]  @relation("ProjectSkills")
  // Extended telemetry/architecture fields
  titleUz        String   @default("")
  titleEn        String   @default("")
  summaryUz      String   @default("")
  summaryEn      String   @default("")
  contentUz      String   @default("")
  contentEn      String   @default("")
  architectureUz String   @default("")
  architectureEn String   @default("")
  tags           String   @default("")
  metrics        String   @default("")
  imageUrl       String   @default("")
  githubUrl      String   @default("")
  views          Int      @default(120)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// 4. Post (Many-to-many with Tag)
model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title_uz    String
  title_en    String
  excerpt_uz  String
  excerpt_en  String
  content_uz  String    // Markdown
  content_en  String    // Markdown
  coverImage  String    @default("")
  readingTime Int       @default(6)
  published   Boolean   @default(true)
  publishedAt DateTime? @default(now())
  tagsRelation Tag[]    @relation("PostTags")
  // Extended fields
  titleUz     String    @default("")
  titleEn     String    @default("")
  excerptUz   String    @default("")
  excerptEn   String    @default("")
  contentUz   String    @default("")
  contentEn   String    @default("")
  category    String    @default("Cybersecurity / CTF")
  tags        String    @default("")
  readTime    Int       @default(6)
  views       Int       @default(240)
  likes       Int       @default(38)
  featured    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// 5. Tag (Many-to-many with Post)
model Tag {
  id      String @id @default(cuid())
  slug    String @unique
  name_uz String
  name_en String
  posts   Post[] @relation("PostTags")
}

// 6. Skill (level 1-5 per Section 6 + many-to-many with Project)
model Skill {
  id            String    @id @default(cuid())
  name          String
  category      String    // "AI" | "CYBERSECURITY" | "DEVOPS" | "CORE"
  level         Int       @default(5) // 1-5 scale (or percentage)
  icon          String    @default("Cpu")
  order         Int       @default(0)
  projects      Project[] @relation("ProjectSkills")
  descriptionUz String    @default("")
  descriptionEn String    @default("")
  featured      Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

// 7. Experience (work / education)
model Experience {
  id             String   @id @default(cuid())
  type           String   @default("work") // "work" | "education"
  organization   String
  role_uz        String
  role_en        String
  description_uz String
  description_en String
  startDate      String
  endDate        String   @default("Present")
  order          Int      @default(0)
  // Compat fields
  company        String   @default("")
  roleUz         String   @default("")
  roleEn         String   @default("")
  period         String   @default("")
  location       String   @default("Tashkent / Remote")
  descriptionUz  String   @default("")
  descriptionEn  String   @default("")
  technologies   String   @default("")
  current        Boolean  @default(false)
  createdAt      DateTime @default(now())
}

// 8. Certificate
model Certificate {
  id            String   @id @default(cuid())
  title_uz      String
  title_en      String
  issuer        String
  issueDate     String
  image         String   @default("")
  credentialUrl String
  order         Int      @default(0)
  // Compat fields
  titleUz       String   @default("")
  titleEn       String   @default("")
  credentialId  String   @default("")
  category      String   @default("CYBERSECURITY")
  badgeUrl      String   @default("")
  verified      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

// 9. Resource (book / course / tool / article)
model Resource {
  id             String   @id @default(cuid())
  title_uz       String
  title_en       String
  description_uz String
  description_en String
  url            String
  category       String   // "book" | "course" | "tool" | "article"
  order          Int      @default(0)
  published      Boolean  @default(true)
  // Compat fields
  titleUz        String   @default("")
  titleEn        String   @default("")
  descriptionUz  String   @default("")
  descriptionEn  String   @default("")
  type           String   @default("TOOL")
  downloadUrl    String   @default("")
  featured       Boolean  @default(true)
  downloads      Int      @default(180)
  createdAt      DateTime @default(now())
}

// 10. Speaking events (single canonical model; the old duplicate `Talk` table was removed)
model Speaking {
  id            String   @id @default(cuid())
  titleUz       String
  titleEn       String
  eventUz       String
  eventEn       String
  date          String
  location      String
  type          String   @default("KEYNOTE")
  slidesUrl     String   @default("")
  videoUrl      String   @default("")
  descriptionUz String
  descriptionEn String
  featured      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

// 11. ContactMessage (the old duplicate `Message` table was merged into this one)
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  category  String   @default("PROJECT")
  message   String
  encrypted Boolean  @default(false)
  isRead    Boolean  @default(false)
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

// 12. Page (Editable static pages like privacy)
model Page {
  id         String   @id @default(cuid())
  key        String   @unique // e.g. "privacy"
  title_uz   String
  title_en   String
  content_uz String   // Markdown
  content_en String   // Markdown
  updatedAt  DateTime @updatedAt
}

// 13. Media (Uploaded files library)
model Media {
  id        String   @id @default(cuid())
  url       String
  alt_uz    String   @default("")
  alt_en    String   @default("")
  type      String   @default("image/png")
  size      Int      @default(0)
  createdAt DateTime @default(now())
}

// 14. Setting (Key-value JSON settings)
model Setting {
  key   String @id
  value String // JSON string
}
